# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=school_social_app

# Application
PORT=3000
NODE_ENV=development
API_URL=http://localhost:3000

# JWT — three different random values, 32+ chars each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRATION=7d
JWT_RESET_SECRET=your-password-reset-secret-change-in-production

# OTP
OTP_EXPIRY_MINUTES=10

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@schoolsocial.app

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Paystack (Campus Coins purchases)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stream Video (calls)
STREAM_API_KEY=your-stream-api-key
STREAM_API_SECRET=your-stream-api-secret

# Firebase Cloud Messaging (push notifications)
FIREBASE_SERVICE_ACCOUNT_PATH=./src/config/firebase-service-account.json

# Dashboard admin emails (comma-separated)
ADMIN_EMAILS=admin@mrba.com

# In-app purchases (RevenueCat). Must match the Authorization header set on the RevenueCat webhook.
REVENUECAT_WEBHOOK_AUTH=your-long-random-webhook-secret
# Credit sandbox purchases (App Review / TestFlight). Keep true or review fails.
IAP_ALLOW_SANDBOX=true
# RevenueCat V1 secret API key (sk_...). Backend only, never in the app.
# Lets the backend look up purchases directly if a webhook is late or missing.
REVENUECAT_SECRET_KEY=

# Website origins allowed to call the API from a browser in production (comma-separated).
CORS_ORIGINS=https://www.3names.ng,https://3names.ng
# Where Paystack sends buyers back after a website coin purchase.
WEB_TOPUP_CALLBACK_URL=https://www.3names.ng/coins/complete
